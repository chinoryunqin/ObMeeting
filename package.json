  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.3",
    "obsidian": "^1.8.9",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  }
}
